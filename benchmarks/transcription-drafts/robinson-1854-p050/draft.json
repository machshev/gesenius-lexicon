          "y": 510,
          "width": 780,
          "height": 51
        }
      }
    },
    {
      "line_id": "p0050-right-008",
      "text": "11, comp. 18, 11. Dan. 11, 36 אֵל אֵלִם",
      "source": {
        "source_page": 66,
        "bounds": {
          "x": 995,
          "y": 561,
          "width": 780,
          "height": 50
        }
      }
    },
    {
      "line_id": "p0050-right-009",
      "text": "God of gods, i. e. the supreme God. Also",
      "source": {
        "source_page": 66,
        "bounds": {
          "x": 995,
          "y": 611,
          "width": 780,
          "height": 51
        }
      }
    },
    {
      "line_id": "p0050-right-010",
      "text": "בְּנֵי אֵלִים Ps. 29, 1. 89, 7, sons of the gods,",
