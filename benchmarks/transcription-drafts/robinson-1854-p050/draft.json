      "text": "see above in Sing. no. 1.",
      "source": {
        "source_page": 66,
        "bounds": {
          "x": 995,
          "y": 408,
          "width": 780,
          "height": 50
        }
      }
    },
    {
      "line_id": "p0050-right-006",
      "text": "2. gods, in a wider sense, spoken of",
      "source": {
        "source_page": 66,
        "bounds": {
          "x": 995,
          "y": 458,
          "width": 780,
          "height": 52
        }
      }
    },
